{
  "name": "tasktopia",
  "version": "1.11.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,yellow \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "build": "npm run typecheck && vite build && esbuild src/server/index.ts --bundle --packages=external --platform=node --format=esm --target=node24 --outfile=dist/server.mjs && esbuild src/server/regenerate-worlds.ts --bundle --packages=external --platform=node --format=esm --target=node24 --outfile=dist/regenerate-worlds.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-demo.ts",
    "seed:test": "tsx scripts/seed-test.ts",
    "seed:growth": "tsx scripts/seed-growth-demo.ts",
    "seed:showcase": "tsx scripts/seed-readme-showcase.ts",
    "db:import-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "test:db:start": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:stop": "docker compose -f docker-compose.test.yml down",
    "test:scale": "tsx scripts/worldgen-scale-smoke.ts",
    "test:worldgen": "RUN_ORGANIC_GROWTH_TESTS=1 vitest run tests/organic-growth.test.ts --no-file-parallelism",
    "worlds:regenerate": "node dist/regenerate-worlds.mjs",
    "study:worldgen": "tsx scripts/worldgen-algorithm-study.ts",
    "assets:setup": "python3 -m venv .venv-assets && .venv-assets/bin/python -m pip install -r requirements-assets.txt",
    "assets:build": ".venv-assets/bin/python scripts/build-pixel-city-pack-v4.py",
    "assets:verify": ".venv-assets/bin/python scripts/audit-pixel-city-pack-v4.py && .venv-assets/bin/python .agents/skills/tasktopia-pixel-city-art/scripts/audit_pixel_style.py --manifest assets/pixel-city-pack-v4/manifest.json --runtime assets/pixel-city-pack-v4/runtime --report tmp/pixel-city-style-audit.json"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "10.1.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "fastify": "^5.11.2",
    "pixi.js": "8.19.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  }
}
