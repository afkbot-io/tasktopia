NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://tasktopia:tasktopia@127.0.0.1:5432/tasktopia
TEST_DATABASE_URL=postgres://tasktopia:tasktopia@127.0.0.1:55432/tasktopia_test
APP_ORIGIN=http://localhost:5173
# Production: the CDN custom domain. Keep unset locally.
STATIC_ORIGIN=
AUTH_RATE_LIMIT_MAX=10
# Development keeps self-registration available; production defaults to closed.
REGISTRATION_ENABLED=true
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=info
DATABASE_POOL_MAX=10
# Web/MCP wait for the durable world worker before returning an accepted job.
GENERATION_WAIT_MS=55000
# Optional fail-open cache. Leave empty to use PostgreSQL only.
REDIS_URL=
REDIS_CHUNK_TTL_SECONDS=300
REDIS_OPERATION_TIMEOUT_MS=40
