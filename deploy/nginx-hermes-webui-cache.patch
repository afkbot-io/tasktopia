--- a/etc/nginx/sites-available/hermes-webui
+++ b/etc/nginx/sites-available/hermes-webui
@@ -19,6 +19,18 @@ server {
     client_max_body_size 100m;
     proxy_read_timeout 3600s;
     proxy_send_timeout 3600s;
+
+    # Immutable versioned game assets and hashed bundles — cache for one year.
+    location ~* ^/(game-assets|assets)/ {
+        proxy_pass http://127.0.0.1:3000;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
