APP_ORIGIN=https://tasktopia.online
# Enable only after the CDN hostname has a valid certificate and passes the
# verification commands in docs/DEPLOYMENT.md.
STATIC_ORIGIN=
VITE_STATIC_ORIGIN=
POSTGRES_PASSWORD=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
REGISTRATION_ENABLED=false
# Generate once with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@tasktopia.online
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
LOG_LEVEL=info
GENERATION_WAIT_MS=55000
# Optional: start compose with --profile cache and set redis://redis:6379.
REDIS_URL=
REDIS_CHUNK_TTL_SECONDS=300
REDIS_OPERATION_TIMEOUT_MS=40
REDIS_MEMORY_LIMIT=256mb
REDIS_CONTAINER_MEMORY_LIMIT=320m
REDIS_CPU_LIMIT=0.50
APP_MEMORY_LIMIT=1536m
APP_CPU_LIMIT=2.00
MCP_PORT=3002
MCP_MEMORY_LIMIT=768m
MCP_CPU_LIMIT=1.00
WORLD_PORT=3003
WORLD_MEMORY_LIMIT=1536m
WORLD_CPU_LIMIT=2.00
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.00
