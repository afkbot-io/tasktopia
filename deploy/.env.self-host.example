# Public URL used for CSRF checks and links shown in the UI.
APP_ORIGIN=http://localhost:3000

# Generate a unique value before exposing the service:
#   openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-secret

SESSION_COOKIE_SECURE=false
LOG_LEVEL=info

# The application stays on loopback by default. Put nginx/Caddy in front of it.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Optional CDN. Set both values to the same HTTPS origin or leave both empty.
STATIC_ORIGIN=
VITE_STATIC_ORIGIN=

# Safe single-host resource ceilings; adjust after observing docker stats.
APP_MEMORY_LIMIT=1536m
APP_CPU_LIMIT=2.00
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.00
