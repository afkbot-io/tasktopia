# Public URL used for CSRF checks and links shown in the UI.
APP_ORIGIN=http://localhost:3000

# Generate a unique value before exposing the service:
#   openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-secret

SESSION_COOKIE_SECURE=false
LOG_LEVEL=info
GENERATION_WAIT_MS=55000
# Optional fail-open chunk cache: use redis://redis:6379 with --profile cache.
REDIS_URL=
REDIS_CHUNK_TTL_SECONDS=300
REDIS_OPERATION_TIMEOUT_MS=40
REDIS_MEMORY_LIMIT=256mb
REDIS_CONTAINER_MEMORY_LIMIT=320m
REDIS_CPU_LIMIT=0.50

# Closed by default for private/company deployments. Create accounts with the CLI.
REGISTRATION_ENABLED=false

# Optional Web Push. All three values are required together.
# Generate the key pair once with: npx web-push generate-vapid-keys
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The application stays on loopback by default. Put nginx/Caddy in front of it.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
MCP_PORT=3002
WORLD_PORT=3003

# Optional CDN. This single value configures both the client build and CSP.
STATIC_ORIGIN=

# Update safety. Oldest pre-update dumps are removed after this count.
BACKUP_RETENTION_COUNT=14
MIN_FREE_SPACE_MB=1024

# Safe single-host resource ceilings; adjust after observing docker stats.
APP_MEMORY_LIMIT=1536m
APP_CPU_LIMIT=2.00
MCP_MEMORY_LIMIT=768m
MCP_CPU_LIMIT=1.00
WORLD_MEMORY_LIMIT=1536m
WORLD_CPU_LIMIT=2.00
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.00
